{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Desktop Organizer",
  "version": "0.1.0-beta.2",
  "identifier": "com.ikun.organizer",
  "build": {
    "frontendDist": "frontend/dist",
    "beforeBuildCommand": "cd frontend && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "control-panel",
        "title": "Desktop Organizer",
        "url": "/#/control-panel",
        "width": 576,
        "height": 736,
        "minWidth": 496,
        "minHeight": 516,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": false,
        "center": true
      },
      {
        "label": "create-box",
        "title": "Create Category Box",
        "url": "/#/create-box",
        "width": 416,
        "height": 192,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "center": true
      },
      {
        "label": "edit-box",
        "title": "Edit Category Box",
        "url": "/#/edit-box",
        "width": 416,
        "height": 192,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "center": true
      },
      {
        "label": "ai-classify",
        "title": "AI Classification",
        "url": "/#/ai-classify",
        "width": 400,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "icon": [
      "tauri/icons/32x32.png",
      "tauri/icons/128x128.png",
      "tauri/icons/128x128@2x.png",
      "tauri/icons/icon.icns",
      "tauri/icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
