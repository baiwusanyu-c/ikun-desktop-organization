{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Desktop Organizer",
  "version": "0.1.0-beta.9",
  "identifier": "com.ikun.organizer",
  "build": {
    "frontendDist": "frontend/dist",
    "beforeBuildCommand": "cd frontend && pnpm run build"
  },
  "app": {
    "windows": [
      {
        "label": "control-panel",
        "create": false,
        "title": "Desktop Organizer",
        "url": "/#/control-panel",
        "width": 576,
        "height": 736,
        "minWidth": 496,
        "minHeight": 516,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": false,
        "center": true
      },
      {
        "label": "create-box",
        "create": false,
        "title": "Create Category Box",
        "url": "/#/create-box",
        "width": 416,
        "height": 192,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "center": true
      },
      {
        "label": "edit-box",
        "create": false,
        "title": "Edit Category Box",
        "url": "/#/edit-box",
        "width": 416,
        "height": 192,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "center": true
      },
      {
        "label": "ai-classify",
        "create": false,
        "title": "AI Classification",
        "url": "/#/ai-classify",
        "width": 400,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4NjAyRjAwMzk2NDM0MjgKUldRb05HUTVBQzlnMk5KcGc1OUprdTBTZDUwbkNmcFBzbVhNcWhNa0dqYUtkQTZubDIwSXZpYjAK",
      "endpoints": [
        "https://github.com/baiwusanyu-c/ikun-desktop-organization/releases/download/beta/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": false,
    "icon": [
      "tauri/icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
