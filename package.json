{
  "name": "ikun-organizer-build",
  "private": true,
  "version": "0.1.0-beta.5",
  "description": "Desktop Organizer - build tooling entry (see scripts/build.mjs)",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "pack": "node scripts/build.mjs",
    "pack:win": "node scripts/build.mjs --platform win",
    "pack:debug": "node scripts/build.mjs --mode debug",
    "pack:fast": "node scripts/build.mjs --mode debug --no-installer",
    "release": "node scripts/release.mjs",
    "release:beta": "node scripts/release.mjs --bump beta",
    "release:beta:push": "node scripts/release.mjs --bump beta --push"
  }
}
